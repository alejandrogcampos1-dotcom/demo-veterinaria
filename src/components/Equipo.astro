---
import { negocio } from '../data/negocio';
import Foto from './Foto.astro';
import Mancha from './Mancha.astro';
import TituloSeccion from './TituloSeccion.astro';

const { equipo } = negocio;
const formas = [3, 2, 4] as const;
---

{
  equipo.items.length > 0 && (
    <section id="equipo" class="seccion" aria-labelledby="titulo-equipo">
      <div class="contenedor">
        <TituloSeccion id="titulo-equipo" etiqueta={equipo.etiqueta} titulo={equipo.titulo} texto={equipo.texto} />

        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {equipo.items.map((p, i) => (
            <li data-aparecer style={`--orden:${i}`}>
              <article class="group flex h-full gap-5 rounded-[1.75rem] border border-tinta/[0.07] bg-white p-5 sm:flex-col sm:items-center sm:p-8 sm:text-center lg:p-10">
                <div class="relative size-24 shrink-0 sm:size-44">
                  <Mancha
                    forma={formas[i % formas.length]}
                    class:list={[
                      'absolute -inset-[14%] transition duration-700 ease-suave group-hover:rotate-12',
                      i % 2 === 0 ? 'text-principal/15' : 'text-acento/25',
                    ]}
                  />
                  <Foto
                    foto={p.foto}
                    sizes="(min-width: 640px) 176px, 96px"
                    class="relative size-full rounded-full ring-4 ring-white"
                  />
                </div>

                <div class="flex flex-col sm:items-center">
                  <h3 class="text-lg leading-tight font-bold tracking-[-0.02em] sm:mt-4 sm:text-[1.375rem]">{p.nombre}</h3>
                  <p class="mt-1.5 text-sm font-semibold text-principal">{p.especialidad}</p>
                  <blockquote class="mt-3 text-[0.9375rem] leading-relaxed text-suave sm:mt-5 sm:max-w-[18rem] sm:text-base">
                    <p>“{p.frase}”</p>
                  </blockquote>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
