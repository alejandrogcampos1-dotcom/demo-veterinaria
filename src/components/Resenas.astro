---
// "Lo que dicen en Google": SOLO reseñas reales copiadas de la ficha del negocio.
// Lista vacía = la sección no aparece. En modo demo se ve un bloque punteado que marca el lugar.
import { negocio } from '../data/negocio';
import Icono from './Icono.astro';

const { resenas, demo, modoDemo } = negocio;
const hayResenas = resenas.items.length > 0;

const estrella =
  'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z';
const formatoPuntaje = (n: number) => n.toLocaleString('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---

{
  hayResenas && (
    <section id="resenas" class="seccion" aria-labelledby="titulo-resenas">
      <div class="contenedor">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-10" data-aparecer>
          <div class="lg:col-span-7">
            <p class="etiqueta">{resenas.etiqueta}</p>
            <h2 id="titulo-resenas" class="titulo-seccion mt-4">
              {resenas.titulo}
            </h2>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-4 lg:col-span-5 lg:justify-self-end">
            {resenas.promedio && (
              <div class="flex items-center gap-4">
                <p class="font-display text-5xl leading-none font-extrabold tracking-[-0.04em]">
                  {formatoPuntaje(resenas.promedio)}
                </p>
                <div>
                  <p class="flex gap-0.5 text-acento" role="img" aria-label={`${formatoPuntaje(resenas.promedio)} de 5 estrellas`}>
                    {Array.from({ length: 5 }, (_, n) => (
                      <svg
                        viewBox="0 0 24 24"
                        class:list={['size-4.5', n + 0.5 > (resenas.promedio ?? 0) && 'opacity-25']}
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d={estrella} />
                      </svg>
                    ))}
                  </p>
                  {resenas.total && (
                    <p class="mt-1 text-sm text-suave">
                      {resenas.total.toLocaleString('es-AR')} reseñas en Google
                    </p>
                  )}
                </div>
              </div>
            )}
            {resenas.urlGoogle && (
              <a href={resenas.urlGoogle} target="_blank" rel="noopener" class="boton-secundario">
                {resenas.textoBoton}
                <Icono nombre="flecha-diagonal" class="size-4.5" trazo={2} />
              </a>
            )}
          </div>
        </div>

        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {resenas.items.map((r, i) => (
            <li data-aparecer style={`--orden:${i % 3}`}>
              <figure class="flex h-full flex-col rounded-[1.75rem] border border-tinta/[0.07] bg-white p-7">
                <div class="flex items-center justify-between gap-4">
                  <p class="flex gap-0.5 text-acento" role="img" aria-label={`${r.puntaje} de 5 estrellas`}>
                    {Array.from({ length: 5 }, (_, n) => (
                      <svg viewBox="0 0 24 24" class:list={['size-4', n >= r.puntaje && 'opacity-25']} fill="currentColor" aria-hidden="true">
                        <path d={estrella} />
                      </svg>
                    ))}
                  </p>
                  <span class="text-sm text-suave">{r.fecha}</span>
                </div>
                <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">
                  <p>“{r.texto}”</p>
                </blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-tinta/10 pt-5">
                  <span class="grid size-10 place-items-center rounded-full bg-principal/10 font-display font-bold text-principal">
                    {r.autor.trim().charAt(0).toUpperCase()}
                  </span>
                  <span class="font-semibold">{r.autor}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

{
  !hayResenas && modoDemo && (
    <section class="seccion" aria-label="Lugar para las reseñas de Google">
      <div class="contenedor">
        <div
          class="flex flex-col items-center gap-4 rounded-[2rem] border-2 border-dashed border-tinta/20 bg-tinta/[0.03] px-6 py-12 text-center sm:py-16"
          data-aparecer
        >
          <p class="flex gap-1 text-tinta/30" aria-hidden="true">
            {Array.from({ length: 5 }, () => (
              <svg viewBox="0 0 24 24" class="size-6" fill="currentColor">
                <path d={estrella} />
              </svg>
            ))}
          </p>
          <p class="max-w-md font-display text-xl font-bold tracking-[-0.02em] text-tinta/75 sm:text-2xl">
            {demo.avisoResenas}
          </p>
          <p class="text-sm text-suave">{resenas.titulo} · se completa con la ficha de tu negocio</p>
        </div>
      </div>
    </section>
  )
}
