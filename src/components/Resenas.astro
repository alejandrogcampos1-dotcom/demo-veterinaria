---
// Reseñas: SOLO reales y con permiso del cliente. Si la lista está vacía, no se muestra.
import { negocio } from '../data/negocio';
import TituloSeccion from './TituloSeccion.astro';

const { resenas } = negocio;
---

{
  resenas.items.length > 0 && (
    <section id="resenas" class="seccion" aria-labelledby="titulo-resenas">
      <div class="contenedor">
        <TituloSeccion id="titulo-resenas" etiqueta={resenas.etiqueta} titulo={resenas.titulo} texto={resenas.texto} />

        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {resenas.items.map((r, i) => (
            <li data-aparecer style={`--orden:${i % 3}`}>
              <figure class="flex h-full flex-col rounded-[1.75rem] border border-tinta/[0.07] bg-white p-7">
                {r.estrellas && (
                  <p class="flex gap-1 text-acento" aria-label={`${r.estrellas} de 5 estrellas`}>
                    {Array.from({ length: 5 }, (_, n) => (
                      <svg viewBox="0 0 24 24" class:list={['size-4.5', n >= (r.estrellas ?? 0) && 'opacity-25']} fill="currentColor" aria-hidden="true">
                        <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" />
                      </svg>
                    ))}
                  </p>
                )}
                <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">
                  <p>“{r.texto}”</p>
                </blockquote>
                <figcaption class="mt-6 border-t border-tinta/10 pt-5">
                  <span class="block font-bold">{r.nombre}</span>
                  {r.detalle && <span class="mt-0.5 block text-sm text-suave">{r.detalle}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
