---
// Muestra una foto de src/assets/img optimizada por Astro: AVIF + WebP, varios tamaños
// (srcset), width/height reales para que la página no salte y carga diferida.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { Foto as TipoFoto } from '../data/tipos';

interface Props {
  foto: TipoFoto;
  /** Ancho que ocupa en pantalla, por ejemplo '(min-width: 1024px) 40vw, 100vw' */
  sizes?: string;
  /** true solo para la foto principal (la primera que se ve): carga inmediata y prioridad alta */
  prioridad?: boolean;
  /** 'eager' para fotos chicas que se ven apenas carga la página */
  carga?: 'eager' | 'lazy';
  class?: string;
  /** Para fotos decorativas que repiten información */
  decorativa?: boolean;
}

const { foto, sizes = '100vw', prioridad = false, carga, class: clase, decorativa = false } = Astro.props;

const imagenes = import.meta.glob<{ default: ImageMetadata }>('../assets/img/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const imagen = imagenes[`../assets/img/${foto.src}`]?.default;
if (!imagen) {
  throw new Error(`[Foto] No encuentro "${foto.src}" en src/assets/img. Revisá el nombre en negocio.ts.`);
}

// Tamaños que se generan (nunca más grandes que la original)
const anchos = [...[240, 480, 720, 960, 1280].filter((a) => a < imagen.width), imagen.width];
---

<Picture
  src={imagen}
  formats={['avif']}
  fallbackFormat="webp"
  widths={anchos}
  sizes={sizes}
  quality={78}
  alt={decorativa ? '' : foto.alt}
  loading={prioridad ? 'eager' : (carga ?? 'lazy')}
  fetchpriority={prioridad ? 'high' : undefined}
  decoding={prioridad ? 'sync' : 'async'}
  pictureAttributes={{ class: 'contents' }}
  class:list={[!clase?.includes('object-contain') && 'object-cover', clase]}
/>
