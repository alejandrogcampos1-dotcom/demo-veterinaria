---
import { negocio } from '../data/negocio';
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import TituloSeccion from './TituloSeccion.astro';

const { porQue, marca } = negocio;
const anios = marca.desde ? new Date().getFullYear() - marca.desde : 0;
---

{
  porQue.items.length > 0 && (
    <section id="por-que" class="px-3 sm:px-5" aria-labelledby="titulo-por-que">
      <div class="grano relative mx-auto max-w-[96rem] overflow-hidden rounded-[2.25rem] bg-principal text-sobre-principal sm:rounded-[3rem]">
        <div class="huellitas pointer-events-none absolute inset-0 text-sobre-principal opacity-[0.06]" aria-hidden="true" />

        <div class="contenedor seccion relative grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
          {porQue.imagen && (
            <div class="relative lg:col-span-5" data-aparecer>
              <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] rounded-tl-[7rem] shadow-[0_40px_80px_-40px_rgba(0,0,0,0.6)]">
                <Foto foto={porQue.imagen} sizes="(min-width: 1024px) 34vw, 92vw" class="size-full" />
              </div>
              {anios > 0 && (
                <div class="absolute -right-2 -bottom-8 rounded-[1.75rem] bg-fondo px-6 py-5 text-tinta shadow-[0_30px_60px_-24px_rgba(0,0,0,0.55)] sm:-right-8">
                  <p class="font-display text-5xl leading-none font-extrabold tracking-[-0.05em]">
                    {anios}
                  </p>
                  <p class="mt-1.5 text-sm font-medium text-suave">
                    años cuidando
                    <br />a {negocio.contacto.direccion.localidad}
                  </p>
                </div>
              )}
            </div>
          )}

          <div class:list={[porQue.imagen ? 'lg:col-span-7' : 'lg:col-span-12']}>
            <TituloSeccion
              id="titulo-por-que"
              etiqueta={porQue.etiqueta}
              titulo={porQue.titulo}
              texto={porQue.texto}
              disposicion="apilado"
              claro
            />

            <ul class="mt-12 grid gap-x-10 gap-y-9 sm:grid-cols-2">
              {porQue.items.map((p, i) => (
                <li
                  class="grid grid-cols-[auto_1fr] gap-x-4 border-t border-sobre-principal/20 pt-6 sm:block"
                  data-aparecer
                  style={`--orden:${i}`}
                >
                  <span class="row-span-2 grid size-12 place-items-center rounded-2xl bg-sobre-principal/10 ring-1 ring-sobre-principal/15">
                    <Icono nombre={p.icono} class="size-6" trazo={1.6} />
                  </span>
                  <h3 class="self-center text-xl font-bold tracking-[-0.02em] sm:mt-5">{p.titulo}</h3>
                  <p class="mt-2 leading-relaxed text-sobre-principal/90">{p.texto}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
