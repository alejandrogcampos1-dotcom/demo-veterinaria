---
import { negocio } from '../data/negocio';
import { linkWhatsApp } from '../lib/utilidades';
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import Mancha from './Mancha.astro';

const { hero, marca, contacto, horarios } = negocio;
const titulo = hero.titulo || marca.eslogan;

// Partimos el título para subrayar la parte destacada y meter la fotito después
const indice = hero.destacado ? titulo.indexOf(hero.destacado) : -1;
const partes =
  indice >= 0 && hero.destacado
    ? {
        antes: titulo.slice(0, indice),
        destacado: hero.destacado,
        despues: titulo.slice(indice + hero.destacado.length),
      }
    : { antes: titulo, destacado: '', despues: '' };

const textoInsignia = `${marca.nombre} · ${contacto.direccion.localidad} · `;
---

<section id="inicio" class="relative overflow-x-clip pt-8 pb-16 sm:pt-12 lg:pt-16 lg:pb-24">
  <!-- Huellitas de fondo -->
  <div
    class="huellitas pointer-events-none absolute inset-x-0 top-0 h-[38rem] text-principal opacity-[0.05] [mask-image:linear-gradient(to_bottom,black,transparent)]"
    aria-hidden="true"
  >
  </div>

  <div class="contenedor relative grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <p
        class="inline-flex items-center gap-2.5 rounded-full border border-tinta/[0.08] bg-white/70 py-1.5 pr-4 pl-1.5 text-[0.8125rem] font-medium text-tinta/80 shadow-[0_1px_0_rgba(15,23,42,0.04)]"
      >
        <span
          class="group/estado inline-flex items-center gap-1.5 rounded-full bg-principal/10 px-2.5 py-1 text-xs font-semibold text-principal-oscuro data-[abierto=false]:bg-acento/15 data-[abierto=false]:text-tinta data-[abierto=true]:bg-exito/15 data-[abierto=true]:text-tinta"
          data-estado="corto"
        >
          <span
            class="size-1.5 rounded-full bg-current group-data-[abierto=false]/estado:bg-acento group-data-[abierto=true]/estado:latido group-data-[abierto=true]/estado:bg-exito group-data-[abierto=true]/estado:text-exito"
          ></span>
          <span data-estado-texto>{contacto.direccion.localidad}</span>
        </span>
        {hero.etiqueta}
      </p>

      <h1
        class="mt-7 text-[2.75rem] leading-[0.98] font-extrabold tracking-[-0.045em] text-tinta min-[400px]:text-[3rem] sm:text-[4rem] lg:text-[4.6rem] xl:text-[5.4rem]"
      >
        {partes.antes}
        {
          partes.destacado && (
            <span class="relative inline-block whitespace-nowrap text-principal">
              {partes.destacado}
              <svg
                class="trazo absolute -bottom-[0.14em] left-[-2%] h-[0.32em] w-[104%] text-acento"
                viewBox="0 0 300 24"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <path
                  d="M4 17C52 8 118 4 176 6c44 1.5 82 5 120 10"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="7"
                  class="[stroke-width:5] lg:[stroke-width:7]"
                  stroke-linecap="round"
                  pathLength="1"
                  vector-effect="non-scaling-stroke"
                />
              </svg>
            </span>
          )
        }
        {
          hero.imagenTitulo && (
            <span class="relative mx-[0.04em] inline-block h-[0.78em] w-[1.45em] -translate-y-[0.04em] overflow-hidden rounded-full align-middle ring-[0.06em] ring-fondo shadow-[0_8px_20px_-8px_rgba(15,23,42,0.5)]">
              <Foto foto={hero.imagenTitulo} decorativa sizes="120px" carga="eager" class="size-full" />
            </span>
          )
        }
        {partes.despues}
      </h1>

      <p class="mt-7 max-w-[34rem] text-[1.0625rem] leading-relaxed text-suave sm:text-lg">
        {hero.subtitulo}
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={linkWhatsApp(contacto.whatsapp, contacto.mensajeWhatsapp)}
          target="_blank"
          rel="noopener"
          class="boton-principal min-h-14 px-7 text-base"
        >
          <Icono nombre="chat" class="size-5" trazo={2} />
          {hero.botonPrincipal}
        </a>
        <a href="#servicios" class="boton-secundario group min-h-14 px-7 text-base">
          {hero.botonSecundario}
          <Icono nombre="flecha" class="size-4.5 rotate-90 transition duration-300 group-hover:translate-y-0.5" trazo={2} />
        </a>
      </div>

      {
        hero.datos.length > 0 && (
          <ul class="mt-12 grid max-w-[36rem] grid-cols-3 gap-3 border-t border-tinta/10 pt-7 sm:gap-6">
            {hero.datos.map((d) => (
              <li class="flex flex-col gap-3">
                <span class="grid size-10 place-items-center rounded-xl bg-white text-principal shadow-[0_1px_0_rgba(15,23,42,0.06),0_6px_16px_-10px_rgba(15,23,42,0.35)]">
                  <Icono nombre={d.icono} class="size-5" />
                </span>
                <span>
                  <span class="block font-display text-[0.9375rem] leading-tight font-bold tracking-tight sm:text-base">
                    {d.titulo}
                  </span>
                  <span class="mt-1 block text-[0.8125rem] leading-snug text-suave">{d.texto}</span>
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <!-- Foto principal -->
    <div class="relative mx-auto w-full max-w-[26rem] sm:max-w-[30rem] lg:col-span-5 lg:max-w-none">
      <!-- Forma orgánica detrás de la foto -->
      <Mancha forma={1} class="absolute -top-[7%] -right-[14%] w-[92%] text-acento lg:-right-[18%]" />

      <div
        class="relative aspect-[4/5] overflow-hidden rounded-t-[999px] rounded-b-[2.25rem] bg-principal/10 shadow-[0_40px_80px_-40px_rgba(15,23,42,0.55)]"
      >
        <Foto
          foto={hero.imagen}
          prioridad
          sizes="(min-width: 1024px) 34vw, (min-width: 640px) 480px, 92vw"
          class="size-full object-[50%_35%]"
        />
      </div>

      <!-- Insignia giratoria -->
      <div
        class="absolute -top-3 -left-3 grid size-28 place-items-center rounded-full bg-tinta text-fondo shadow-xl sm:size-32 lg:-left-10"
        aria-hidden="true"
      >
        <svg viewBox="0 0 100 100" class="absolute inset-0 size-full animate-girar">
          <defs>
            <path id="circulo-insignia" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0"></path>
          </defs>
          <text class="fill-current font-display text-[8.6px] font-bold tracking-[0.18em] uppercase">
            <textPath href="#circulo-insignia" textLength="228">{textoInsignia}</textPath>
          </text>
        </svg>
        <span class="grid size-11 place-items-center rounded-full bg-acento text-sobre-acento">
          <Icono nombre="huella" class="size-5.5 -rotate-12" trazo={2} />
        </span>
      </div>

      <!-- Tarjeta flotante de urgencias -->
      {
        horarios.urgencias && (
          <div class="absolute -bottom-6 left-1/2 flex w-max max-w-[calc(100%-1rem)] -translate-x-1/2 items-center gap-3 rounded-2xl border border-tinta/[0.06] bg-white/95 py-3 pr-5 pl-3 shadow-[0_24px_50px_-20px_rgba(15,23,42,0.45)] backdrop-blur sm:left-auto sm:-left-10 sm:translate-x-0 lg:-left-14">
            <span class="relative grid size-11 shrink-0 place-items-center rounded-xl bg-acento/15 text-acento">
              <Icono nombre="sirena" class="size-5.5" trazo={2} />
              <span class="latido absolute! top-1.5 right-1.5 size-2 rounded-full bg-acento text-acento" />
            </span>
            <span class="leading-tight">
              <span class="block font-display text-[0.9375rem] font-bold tracking-tight">{horarios.urgencias}</span>
              <a href={`tel:${contacto.telefonoLink}`} class="mt-0.5 block text-[0.8125rem] font-medium text-suave hover:text-tinta">
                Guardia: {contacto.telefono}
              </a>
            </span>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .trazo path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: trazar 1.1s 0.5s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  @keyframes trazar {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
